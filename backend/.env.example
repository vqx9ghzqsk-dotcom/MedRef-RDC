# Serveur
PORT=4000
NODE_ENV=development
# Origines autorisées (séparées par des virgules)
CORS_ORIGIN=http://localhost:5173

# MySQL 8
DB_HOST=localhost
DB_PORT=3306
DB_USER=medref
DB_PASSWORD=medref
DB_NAME=medref_rdc

# JWT — remplacez par une longue chaîne aléatoire en production
JWT_SECRET=change-me-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Sauvegardes automatiques (voir README, « Protection des données »)
# BACKUP_DIR=D:/MedRefRDC-sauvegardes
BACKUP_KEEP=30
BACKUP_INTERVAL_HOURS=24
BACKUP_AUTO=1

# Contenu médical
REVISION_MOIS=24            # délai avant qu'une fiche validée soit « à revoir »
VALIDATION_DOUBLE=0         # 1 = celui qui modifie une fiche ne peut pas la valider lui-même

# Sécurité des comptes
JWT_EDITOR_EXPIRES_IN=12h   # sessions des comptes admin / medecin
CONNEXION_MAX_ECHECS=5      # blocage après N mots de passe erronés…
CONNEXION_BLOCAGE_MINUTES=15  # …pendant N minutes

# Journal des erreurs (30 jours conservés)
# LOG_DIR=D:/MedRefRDC-journaux
# Mise en ligne : interface compilée servie par l'API (voir README)
# FRONTEND_DIST=../frontend/dist
