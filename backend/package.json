{
  "name": "medref-rdc-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API MedRef RDC — bibliothèque médicale de référence adaptée à la RDC",
  "author": "Dr Ben Mingalu <bmingalu@gmail.com>",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:migrate": "node scripts/migrate.js",
    "db:status": "node scripts/migrate.js --status",
    "db:reset": "node scripts/migrate.js --reset --seed",
    "db:backup": "node scripts/backup.js",
    "db:restore": "node scripts/backup.js --restaurer",
    "db:enrichir": "node scripts/enrichir.js",
    "test": "jest --runInBand",
    "test:integration": "jest --runInBand --testPathPattern integration",
    "lint": "eslint src tests scripts",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\" \"scripts/**/*.js\"",
    "user:role": "node scripts/role.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  }
}
